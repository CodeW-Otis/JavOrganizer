<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JavOrganizer - multi-version Jellyfin plugin.

    One build per Jellyfin line (their assemblies are not binary-compatible
    across minor versions). Select the target with -p:JellyfinVersion=...:

      dotnet publish -c Release -p:JellyfinVersion=10.8   -> net6.0  (Jellyfin 10.8.x)
      dotnet publish -c Release -p:JellyfinVersion=10.9   -> net8.0  (Jellyfin 10.9.x)
      dotnet publish -c Release -p:JellyfinVersion=10.10  -> net8.0  (Jellyfin 10.10.x)
      dotnet publish -c Release -p:JellyfinVersion=10.11  -> net9.0  (Jellyfin 10.11.x)
      dotnet publish -c Release -p:JellyfinVersion=12.0   -> net10.0 (Jellyfin 12.0.x)

    Omitting JellyfinVersion builds the newest (12.0).
    Package versions are pinned to the exact releases each target was
    verified against; bump them deliberately when re-verifying.
  -->

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.JavOrganizer</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.JavOrganizer</AssemblyName>
    <Version>1.5.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0</JellyfinVersion>
  </PropertyGroup>

  <!-- Per-Jellyfin-line target framework and pinned package versions. -->
  <PropertyGroup Condition="'$(JellyfinVersion)' == '10.8'">
    <TargetFramework>net6.0</TargetFramework>
    <JellyfinPackages>10.8.13</JellyfinPackages>
    <DefineConstants>$(DefineConstants);JF_LEGACY_PERSON;JF_LEGACY_TASK_TRIGGER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JellyfinVersion)' == '10.9'">
    <TargetFramework>net8.0</TargetFramework>
    <JellyfinPackages>10.9.11</JellyfinPackages>
    <DefineConstants>$(DefineConstants);JF_LEGACY_TASK_TRIGGER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JellyfinVersion)' == '10.10'">
    <TargetFramework>net8.0</TargetFramework>
    <JellyfinPackages>10.10.7</JellyfinPackages>
    <DefineConstants>$(DefineConstants);JF_LEGACY_TASK_TRIGGER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JellyfinVersion)' == '10.11'">
    <TargetFramework>net9.0</TargetFramework>
    <JellyfinPackages>10.11.11</JellyfinPackages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JellyfinVersion)' == '12.0'">
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinPackages>12.0.0</JellyfinPackages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the host framework without shipping it. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackages)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackages)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.74" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <None Remove="Configuration\scanPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\scanPage.html" />
  </ItemGroup>

  <!-- The tools folder (smoke tests) lives under the project directory but
       builds as its own project; keep it out of this project's globs. -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
  </ItemGroup>

</Project>
